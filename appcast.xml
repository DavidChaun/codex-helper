            <title>1.9.0</title>
            <pubDate>Mon, 02 Nov 2026 11:00:08 +0800</pubDate>
            <link>https://github.com/DavidChaun/codex-helper/releases/tag/v1.9.0</link>
            <sparkle:version>54</sparkle:version>
